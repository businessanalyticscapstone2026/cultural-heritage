# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real secrets.

# From Supabase dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# CHT-136 Taal municipal portal API (/api/v1/taal/*).
# Comma-separated list of browser origins allowed to call the API (exact match,
# scheme + host + optional port, no trailing slash, no wildcards).
# Empty = no browser origin allowed (server-to-server calls still work).
# Example: https://taal.example.gov.ph,http://localhost:5173
TAAL_PORTAL_ALLOWED_ORIGINS=
